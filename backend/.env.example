# Copy to backend/.env and fill in. Never commit the real file.

# Census Data API. Required: since 2026 the API redirects keyless calls to
# missing_key.html. https://api.census.gov/data/key_signup.html
CENSUS_API_KEY= 

# NLR developer network (PVWatts and the station locator).
# https://developer.nlr.gov/signup/
NLR_API_KEY= 

# Gemini API. Optional: without it the narrative uses the built-in template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ACS_YEAR=2024
MAX_COUNTIES=4

# Google Earth Engine (noncommercial project). Locally, run `earthengine authenticate` once.
EE_PROJECT=
